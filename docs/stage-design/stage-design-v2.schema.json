{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VibeVmix 2.1.0 舞台设计模板",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "module", "slot", "id", "name", "scene", "elements"],
  "properties": {
    "format": {
      "const": "vibe-vmix-graphics"
    },
    "version": {
      "const": 2
    },
    "module": {
      "const": "stage"
    },
    "slot": {
      "enum": ["caption", "promotion"]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$",
      "not": {
        "enum": ["classic", "constructor", "prototype"]
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "position"],
      "properties": {
        "width": {
          "type": "number",
          "minimum": 64,
          "maximum": 1920
        },
        "height": {
          "type": "number",
          "minimum": 24,
          "maximum": 1080
        },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1920
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1080
            }
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enter", "exit"],
      "properties": {
        "enter": {
          "$ref": "#/$defs/track"
        },
        "exit": {
          "$ref": "#/$defs/track"
        }
      }
    },
    "roster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": "number",
          "minimum": 0,
          "maximum": 1080
        },
        "rowHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 1080
        },
        "bottom": {
          "type": "number",
          "minimum": 0,
          "maximum": 1080
        },
        "gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1920
        },
        "minColumnWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 1920
        },
        "headings": {
          "type": "boolean"
        },
        "repeatArt": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "slot": {
            "const": "caption"
          }
        }
      },
      "then": {
        "not": {
          "required": ["roster"]
        },
        "properties": {
          "elements": {
            "contains": {
              "type": "object",
              "required": ["type", "bind"],
              "properties": {
                "type": {
                  "const": "text"
                },
                "bind": {
                  "const": "caption.text"
                }
              }
            },
            "items": {
              "not": {
                "required": ["bind"],
                "properties": {
                  "bind": {
                    "enum": [
                      "promotion.title",
                      "promotion.page",
                      "promotion.rank",
                      "promotion.name",
                      "promotion.program",
                      "promotion.score"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "slot": {
            "const": "promotion"
          }
        }
      },
      "then": {
        "properties": {
          "elements": {
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": ["type", "bind"],
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "bind": {
                      "const": "promotion.title"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": ["type", "bind"],
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "bind": {
                      "const": "promotion.name"
                    }
                  }
                }
              }
            ],
            "items": {
              "not": {
                "required": ["bind"],
                "properties": {
                  "bind": {
                    "const": "caption.text"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "element": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "x", "y", "width", "height", "color"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "rect"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1920
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1080
            },
            "width": {
              "type": "number",
              "minimum": 1,
              "maximum": 1920
            },
            "height": {
              "type": "number",
              "minimum": 1,
              "maximum": 1080
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "color": {
              "type": "string",
              "pattern": "^#[A-Fa-f0-9]{6}$"
            },
            "radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 64
            },
            "colorField": {
              "const": ""
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "x", "y", "width", "height"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "image"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1920
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1080
            },
            "width": {
              "type": "number",
              "minimum": 1,
              "maximum": 1920
            },
            "height": {
              "type": "number",
              "minimum": 1,
              "maximum": 1080
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "src": {
              "type": "string",
              "maxLength": 2500000,
              "pattern": "^(?:|data:image/png;base64,iVBORw0KGgo[A-Za-z0-9+/]*={0,2})$"
            },
            "bind": {
              "const": "event.logo"
            },
            "fit": {
              "enum": ["contain", "cover", "fill"]
            }
          },
          "anyOf": [
            {
              "required": ["bind"]
            },
            {
              "required": ["src"],
              "properties": {
                "src": {
                  "minLength": 1
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "required": ["type", "x", "y", "width", "height", "src"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "video"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1920
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1080
            },
            "width": {
              "type": "number",
              "minimum": 1,
              "maximum": 1920
            },
            "height": {
              "type": "number",
              "minimum": 1,
              "maximum": 1080
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "src": {
              "type": "string",
              "maxLength": 2500000,
              "pattern": "^data:video/webm;base64,GkXf[A-Za-z0-9+/]*={0,2}$"
            },
            "fit": {
              "enum": ["contain", "cover", "fill"]
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "x", "y", "width", "height", "fontSize", "color"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "text"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1920
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1080
            },
            "width": {
              "type": "number",
              "minimum": 1,
              "maximum": 1920
            },
            "height": {
              "type": "number",
              "minimum": 1,
              "maximum": 1080
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bind": {
              "enum": [
                "",
                "caption.text",
                "promotion.title",
                "promotion.page",
                "promotion.rank",
                "promotion.name",
                "promotion.program",
                "promotion.score"
              ]
            },
            "text": {
              "type": "string",
              "maxLength": 160
            },
            "align": {
              "enum": ["left", "center", "right"]
            },
            "font": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "文字、数字、空格和连字符。需安装在播出电脑。"
            },
            "latinFont": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "文字、数字、空格和连字符。需安装在播出电脑。"
            },
            "weight": {
              "type": "number",
              "minimum": 100,
              "maximum": 900
            },
            "fontSize": {
              "type": "number",
              "minimum": 8,
              "maximum": 144
            },
            "minFontSize": {
              "type": "number",
              "minimum": 8,
              "maximum": 144
            },
            "color": {
              "type": "string",
              "pattern": "^#[A-Fa-f0-9]{6}$"
            },
            "inkField": {
              "const": ""
            },
            "wrap": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration", "frames"],
      "properties": {
        "duration": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        "frames": {
          "type": "array",
          "minItems": 2,
          "maxItems": 240,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["t", "x", "y", "opacity"],
            "properties": {
              "t": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "x": {
                "type": "number",
                "minimum": -1920,
                "maximum": 1920
              },
              "y": {
                "type": "number",
                "minimum": -1080,
                "maximum": 1080
              },
              "sx": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 4
              },
              "sy": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 4
              },
              "rotation": {
                "type": "number",
                "minimum": -360,
                "maximum": 360
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
